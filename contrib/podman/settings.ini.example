[MOODYDUCK]
Debug = 0
TimeZone = Europe/Vienna
Host = moodyduck.example.org
StaticRoot = /app/data/static

[Redis]
URL = redis://moodyduck-valkey:6379/0

; Uncomment to use MySQL instead of SQLite
; [MySQL]
; Database = moodyduck
; Username = moodyduck
; Password = secret
; Host = localhost
; Port = 3306

; Uncomment to use S3-compatible storage for user uploads
; [S3]
; AccessKey = moodyduck
; SecretKey = secret
; Bucket = moodyduck
; Endpoint = https://s3.example.org

; Uncomment to enable Web Push notifications (run manage.py generate_vapid_keys)
; [Push]
; Subject = mailto:you@example.com
; PublicKey = <base64url public key from generate_vapid_keys>
; PrivateKey = -----BEGIN EC PRIVATE KEY-----
;     <key data>
;     -----END EC PRIVATE KEY-----

; Uncomment to enable OpenID Connect authentication
; [OIDC]
; ProviderName = OpenID Connect
; ClientID = your-client-id
; ClientSecret = your-client-secret
; JWKSEndpoint = https://sso.example.org/openid/jwks
; AuthorizationEndpoint = https://sso.example.org/openid/authorize
; TokenEndpoint = https://sso.example.org/openid/token
; UserInfoEndpoint = https://sso.example.org/openid/userinfo
; CreateUsers = 0
