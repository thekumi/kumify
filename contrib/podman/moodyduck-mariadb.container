[Unit]
Description=MoodyDuck MariaDB container
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/mariadb:13
ContainerName=moodyduck-mariadb
Network=moodyduck.network
Volume=moodyduck-db-data:/var/lib/mysql:Z
EnvironmentFile=/etc/moodyduck/db.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
