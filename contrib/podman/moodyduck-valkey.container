[Unit]
Description=MoodyDuck Valkey container
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/valkey/valkey:9-alpine
ContainerName=moodyduck-valkey
Network=moodyduck.network
Volume=moodyduck-valkey-data:/data:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
