FROM docker.io/nikolaik/python-nodejs:python3.12-nodejs22

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY . /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        default-libmysqlclient-dev \
        git \
        gnupg \
        pkg-config && \
    pip install --upgrade pip && \
    pip install -e . && \
    chmod +x /app/contrib/podman/entrypoint.sh && \
    apt-get purge -y build-essential pkg-config && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 9000

ENTRYPOINT ["/app/contrib/podman/entrypoint.sh"]
CMD ["web"]
