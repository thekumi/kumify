[Unit]
Description=MoodyDuck Celery beat container
After=network-online.target moodyduck-valkey.service moodyduck-mariadb.service moodyduck-web.service
Wants=network-online.target
Requires=moodyduck-valkey.service moodyduck-mariadb.service moodyduck-web.service

[Container]
Image=git.private.coffee/kumi/moodyduck:latest
ContainerName=moodyduck-beat
Network=moodyduck.network
Volume=/etc/moodyduck:/etc/moodyduck:ro,Z
Volume=moodyduck-data:/app/data:Z
Environment=MOODYDUCK_SETTINGS=/etc/moodyduck/settings.ini
Exec=beat
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
